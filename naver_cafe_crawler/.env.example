# ===== 네이버 카페 크롤러 설정 (복사하여 .env 로 저장) =====
# 대상 카페 주소
CAFE_URL=https://cafe.naver.com/adoutdoor

# 로컬 경로 (기본값 사용 권장)
BROWSER_PROFILE_DIR=./browser_profile
DB_PATH=./data/cafe.db
LOG_DIR=./logs
EXPORT_DIR=./exports
MEDIA_DIR=./data/media
DIAGNOSTICS_DIR=./diagnostics

# 브라우저: false 이면 창이 보입니다(권장: 보안확인 화면을 직접 볼 수 있음)
HEADLESS=false
# 설치된 Chrome 사용 시 chrome (비워두면 Playwright Chromium)
BROWSER_CHANNEL=
# 특수 환경에서만 지정 (Chromium 실행파일 경로)
BROWSER_EXECUTABLE_PATH=
PAGE_TIMEOUT_MS=30000

# 속도 제어 (초) - 서버 부하를 줄이기 위해 낮추지 않는 것을 권장
REQUEST_DELAY_MIN=3.0
REQUEST_DELAY_MAX=6.0
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=10
DEFAULT_MAX_ARTICLES=100

# 이미지·첨부 실제 다운로드: 카페 운영정책/저작권 확인 후에만 true
MEDIA_DOWNLOAD_POLICY_CONFIRMED=false

# ===== URL 템플릿 (현장 진단 후 필요 시 수정) =====
# 사용 가능 변수: {cafe_name} {club_id} {menu_id} {page} {article_id} {query}
LIST_URL_TEMPLATE=https://cafe.naver.com/ArticleList.nhn?search.clubid={club_id}&search.menuid={menu_id}&search.boardtype=L&search.page={page}
ARTICLE_URL_TEMPLATE=https://cafe.naver.com/{cafe_name}/{article_id}
SEARCH_URL_TEMPLATE=https://cafe.naver.com/ArticleSearchList.nhn?search.clubid={club_id}&search.menuid={menu_id}&search.searchBy=0&search.query={query}&search.page={page}
# 카페 내부 검색어 인코딩 (utf-8 또는 euc-kr) - 확인 필요
SEARCH_QUERY_ENCODING=utf-8
