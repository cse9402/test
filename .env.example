# 실제 값을 채운 뒤 파일명을 .env 로 바꾸세요. .env는 절대 커밋하지 마세요.

# auth_type: id_pw 를 쓸 때
BLCM_USER_ID=your_id_here
BLCM_USER_PW=your_password_here

# auth_type: certificate 를 쓸 때
# BLCM_CERT_LABEL: 인증서 목록에서 본인 인증서를 구분하는 표시 문구(별칭 일부 등)
# BLCM_CERT_PW: 인증서 비밀번호
BLCM_CERT_LABEL=your_cert_label_here
BLCM_CERT_PW=your_cert_password_here
